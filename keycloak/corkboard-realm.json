{
  "realm": "corkboard",
  "enabled": true,
  "displayName": "Corkboard (local dev)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "corkboard-ui",
      "name": "Corkboard UI",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4300/*", "http://localhost:8380/*"],
      "webOrigins": ["http://localhost:4300", "http://localhost:8380"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4300/*##http://localhost:8380/*"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "corkboard-ui",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ada",
      "email": "ada@corkboard.test",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Lovelace",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "corkboard", "temporary": false }]
    },
    {
      "username": "grace",
      "email": "grace@corkboard.test",
      "emailVerified": true,
      "firstName": "Grace",
      "lastName": "Hopper",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "corkboard", "temporary": false }]
    }
  ]
}
