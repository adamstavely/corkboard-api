{
  "name": "corkboard-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Corkboard, a collaborative AI whiteboard",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node scripts/migrate.ts",
    "openapi:export": "nest build && node dist/export-openapi.js",
    "search:reindex": "ts-node scripts/reindex.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@elastic/elasticsearch": "8.19.2",
    "@hocuspocus/extension-database": "4.8.0",
    "@hocuspocus/server": "4.8.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.2",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@hocuspocus/provider": "4.8.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
