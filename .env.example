# HTTP port for the API (3700 locally to stay clear of other apps)
PORT=3700

# Postgres. Local dev: the docker-compose database.
DATABASE_URL=postgres://corkboard:corkboard@localhost:5440/corkboard
# Apply pending migrations at startup. Set false where a deploy job runs `npm run db:migrate` instead.
MIGRATE_ON_START=true

# Elasticsearch, for searching boards. Local dev: the docker-compose node.
ES_NODE=http://localhost:9210

# Encrypts workspaces' model API keys at rest: 32 bytes, base64 (openssl rand -base64 32). Keep it secret and stable;
# changing it means re-entering every key. Without it, model connections can't store keys.
MODEL_KEY_SECRET=
