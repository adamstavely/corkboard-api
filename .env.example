# HTTP port for the API (3700 locally to stay clear of other apps)
PORT=3700

# Postgres. Local dev: the docker-compose database.
DATABASE_URL=postgres://corkboard:corkboard@localhost:5440/corkboard
# Apply pending migrations at startup. Set false where a deploy job runs `npm run db:migrate` instead.
MIGRATE_ON_START=true

# The OpenID Connect provider that signs people in. Local dev: the docker-compose Keycloak realm.
OIDC_ISSUER=http://localhost:8280/realms/corkboard
# When set, access tokens must name this audience. The local realm adds the UI's client id.
OIDC_AUDIENCE=corkboard-ui
